<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════ Colors ══════ -->
    <Color x:Key="ColorBackground">#11140D</Color>
    <Color x:Key="ColorSurface">#11140D</Color>
    <Color x:Key="ColorSurfaceContainerLowest">#0C0F09</Color>
    <Color x:Key="ColorSurfaceContainerLow">#1A1D15</Color>
    <Color x:Key="ColorSurfaceContainer">#1E2119</Color>
    <Color x:Key="ColorSurfaceContainerHigh">#282B23</Color>
    <Color x:Key="ColorSurfaceContainerHighest">#33362E</Color>
    <Color x:Key="ColorSurfaceBright">#373A32</Color>
    <Color x:Key="ColorOnSurface">#E2E4D8</Color>
    <Color x:Key="ColorOnSurfaceVariant">#C3C9B6</Color>
    <Color x:Key="ColorOutline">#8D9382</Color>
    <Color x:Key="ColorOutlineVariant">#43493A</Color>
    <Color x:Key="ColorPrimary">#B7E97E</Color>
    <Color x:Key="ColorOnPrimary">#1E3700</Color>
    <Color x:Key="ColorPrimaryContainer">#9CCC65</Color>
    <Color x:Key="ColorSecondary">#81CFFF</Color>
    <Color x:Key="ColorOnSecondary">#00344B</Color>
    <Color x:Key="ColorError">#FFB4AB</Color>

    <!-- ══════ Brushes ══════ -->
    <SolidColorBrush x:Key="BrushBackground"              Color="{StaticResource ColorBackground}"/>
    <SolidColorBrush x:Key="BrushSurface"                 Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BrushSurfaceContainerLow"     Color="{StaticResource ColorSurfaceContainerLow}"/>
    <SolidColorBrush x:Key="BrushSurfaceContainer"        Color="{StaticResource ColorSurfaceContainer}"/>
    <SolidColorBrush x:Key="BrushSurfaceContainerHigh"    Color="{StaticResource ColorSurfaceContainerHigh}"/>
    <SolidColorBrush x:Key="BrushSurfaceContainerHighest" Color="{StaticResource ColorSurfaceContainerHighest}"/>
    <SolidColorBrush x:Key="BrushSurfaceBright"           Color="{StaticResource ColorSurfaceBright}"/>
    <SolidColorBrush x:Key="BrushOnSurface"               Color="{StaticResource ColorOnSurface}"/>
    <SolidColorBrush x:Key="BrushOnSurfaceVariant"        Color="{StaticResource ColorOnSurfaceVariant}"/>
    <SolidColorBrush x:Key="BrushOutline"                 Color="{StaticResource ColorOutline}"/>
    <SolidColorBrush x:Key="BrushOutlineVariant"          Color="{StaticResource ColorOutlineVariant}"/>
    <SolidColorBrush x:Key="BrushPrimary"                 Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="BrushOnPrimary"               Color="{StaticResource ColorOnPrimary}"/>
    <SolidColorBrush x:Key="BrushPrimaryContainer"        Color="{StaticResource ColorPrimaryContainer}"/>
    <SolidColorBrush x:Key="BrushSecondary"               Color="{StaticResource ColorSecondary}"/>
    <SolidColorBrush x:Key="BrushOnSecondary"             Color="{StaticResource ColorOnSecondary}"/>
    <SolidColorBrush x:Key="BrushError"                   Color="{StaticResource ColorError}"/>

    <!-- ══════ Typography sizes ══════ -->
    <x:Double x:Key="FontSizeDisplayLg">32</x:Double>
    <x:Double x:Key="FontSizeHeadlineMd">24</x:Double>
    <x:Double x:Key="FontSizeTitleSm">18</x:Double>
    <x:Double x:Key="FontSizeBodyMd">14</x:Double>
    <x:Double x:Key="FontSizeBodySm">13</x:Double>
    <x:Double x:Key="FontSizeLabelCaps">11</x:Double>

    <!-- ══════ Corner radii ══════ -->
    <CornerRadius x:Key="RadiusSm">2</CornerRadius>
    <CornerRadius x:Key="RadiusMd">4</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

</ResourceDictionary>
