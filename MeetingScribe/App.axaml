<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MeetingScribe.App"
             xmlns:local="using:MeetingScribe"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <!-- Используем абсолютный путь к ресурсу -->
        <StyleInclude Source="avares://MeetingScribe/Styles/LuminaTheme.axaml"/>
    </Application.Styles>
</Application>