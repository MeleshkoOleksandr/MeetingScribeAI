<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MeetingScribe"
             xmlns:vm="using:MeetingScribe.ViewModels"
             xmlns:views="using:MeetingScribe.Views"
             xmlns:conv="using:MeetingScribe.UILogic.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MeetingScribe.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:NewMeetingViewModel}">
            <views:NewMeetingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArchiveViewModel}">
            <views:ArchiveView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TeamViewModel}">
            <views:TeamView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MeetingScribe/Styles/LuminaTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!--  Converters  -->
            <conv:SidebarIconConverter x:Key="SidebarIconConverter"/>
            <conv:SidebarWidthConverter x:Key="SidebarWidthConverter"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles/>
        <StyleInclude Source="avares://MeetingScribe/Styles/LuminaStyles.axaml"/>
    </Application.Styles>
</Application>