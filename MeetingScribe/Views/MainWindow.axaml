<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MeetingScribe.ViewModels"
        xmlns:uilog="using:MeetingScribe.UILogic"
        xmlns:controls="using:MeetingScribe.Views.Controls"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="MeetingScribe.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"

        Width="1200" Height="800"
        MinWidth="1000" MinHeight="700"

        Title="MeetingScribe"
        Icon="/Assets/Images/Logo_main.ico"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"

        FontFamily="Inter,Segoe UI,sans-serif"
        WindowStartupLocation="CenterOwner"
        >

    <Window.Styles>
        <Style Selector="WindowDrawnDecorations TextBlock">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- Template for one menu item -->
        <DataTemplate x:Key="MenuItemTemplate" x:DataType="uilog:NavigationItem">
            <Grid Height="48" Background="Transparent" ToolTip.Tip="{Binding Label}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- The Green Stripe (visible only when selected) -->
                <Border Grid.Column="0" HorizontalAlignment="Left"
                        Width="3" Height="24" CornerRadius="0,2,2,0"
                        Background="{StaticResource BrushPrimary}"
                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                <!-- Icon -->
                <icons:MaterialIcon Grid.Column="0" Kind="{Binding Icon}"
                                    Width="22" Height="22"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- The text is hidden via a binding to IsSidebarExpanded -->
                <TextBlock Grid.Column="1" Text="{Binding Label}"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}"/>

            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ────────────────────────────────────
        LEFT SIDEBAR
        ──────────────────────────────────────── -->
        <Border Grid.Column="0" Classes="sidebar"
                Width="{Binding IsSidebarExpanded, Converter={StaticResource SidebarWidthConverter}}">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, 90">
                <!-- AREA LOGO & TOGGLE -->
                <Border Grid.Row="0" Height="70" PointerPressed="TitleBar_PointerPressed">
                    <Grid>
                        <!-- MAIN TOGGLE BUTTON (≡) -->
                        <Button Command="{Binding ToggleSidebarCommand}"
                                Classes="btn-icon"
                                Width="48" Height="48"
                                HorizontalAlignment="Left"
                                Margin="8,0,0,0"
                                Background="Transparent">
                            <!-- The icon changes automatically via the converter -->
                            <icons:MaterialIcon Kind="{Binding IsSidebarExpanded, Converter={StaticResource SidebarIconConverter}}"
                                                Width="30" Height="30"
                                                Foreground="{StaticResource BrushPrimary}"/>
                        </Button>
                        <!-- LOGO + TEXT GROUP (Visible only when expanded) -->
                        <StackPanel Orientation="Horizontal"
                                    IsVisible="{Binding IsSidebarExpanded}"
                                    Margin="55,0,0,0"
                                    VerticalAlignment="Center">
                            <!-- Logo -->
                            <Image Source="/Assets/Images/Logo_main.png"
                                   Width="60" Height="40"
                                   VerticalAlignment="Center"/>
                            <!-- Text -->
                            <StackPanel Margin="1,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Meeting" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Scribe" Foreground="White" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- TOP DIVIDER -->
                <Border Grid.Row="1" Background="{StaticResource BrushOutlineVariant}"  Height="1" Margin="15,10" Opacity="0.6"/>
                <!-- Navigation Menu -->
                <!-- Main ListBox (Static Items) -->
                <ListBox Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding PageList.MenuItems}"
                         SelectedItem="{Binding SelectedMenuItem}"
                         ItemTemplate="{StaticResource MenuItemTemplate}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>

                <!--  Dynamic Divider (Visible only if TemporaryItems is not empty) -->
                <Border Grid.Row="3" Background="{StaticResource BrushOutlineVariant}"  Height="1" Margin="15,10" Opacity="0.6"
                        IsVisible="{Binding !!PageList.TemporaryItems.Count}"/>

                <!--  Temporary ListBox (Active Meetings / Recordings) -->
                <ListBox Grid.Row="4" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding PageList.TemporaryItems}"
                         SelectedItem="{Binding SelectedMenuItem}"
                         ItemTemplate="{StaticResource MenuItemTemplate}">
                    <!-- Styles same as main ListBox -->
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
                <!-- BOTTOM DIVIDER -->
                <Border Grid.Row="5" Classes="divider-h" Margin="15,10" Opacity="0.6"/>
                <!-- OPTIONAL BOTTOM CONTENT-->
            </Grid>
        </Border>

        <!-- ────────────────────────────────────
        MAIN CONTENT
        ──────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0" Classes="top-bar" PointerPressed="TitleBar_PointerPressed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <icons:MaterialIcon Kind="{Binding SelectedMenuItem.Icon}" Width="18" Height="18"
                                            Foreground="{StaticResource BrushPrimary}"/>
                        <TextBlock Text="{Binding SelectedMenuItem.Label}" Classes="title-sm" VerticalAlignment="Center"/>
                        <Border Classes="divider-v" Height="16" />
                        <TextBlock Text="{Binding SelectedMenuItem.Description}" Classes="body-sm text-muted" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right side icons (Notifications/Help) from your mockup -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="btn-icon">
                            <icons:MaterialIcon Kind="BellOutline" Width="18" Height="18"/>
                        </Button>
                        <Button Classes="btn-icon">
                            <icons:MaterialIcon Kind="HelpCircleOutline" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" RowDefinitions="*, Auto">
                <!--Dynamic Content Area - Main App Info-->
                <ContentControl Grid.Row="0" Content="{Binding CurrentPage}" />
                <!--Live recording meeting control -->
                <controls:AudioBottomBar Grid.Row="1" IsVisible="{Binding IsRecording}" />
            </Grid>

        </Grid>

    </Grid>


</Window>