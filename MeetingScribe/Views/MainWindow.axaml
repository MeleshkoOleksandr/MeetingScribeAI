<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MeetingScribe.ViewModels"
        xmlns:uilog="using:MeetingScribe.UILogic"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="MeetingScribe.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"

        Width="1280" Height="800"
        MinWidth="800" MinHeight="750"

        Title="MeetingScribe"
        Icon="/Assets/Images/Logo_main.ico"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"

        FontFamily="Inter,Segoe UI,sans-serif"
        WindowStartupLocation="CenterScreen"
        >

    <Window.Styles>
        <Style Selector="WindowDrawnDecorations TextBlock">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- Template for one menu item -->
        <DataTemplate x:Key="MenuItemTemplate" x:DataType="uilog:NavigationItem">
            <Grid Height="44" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- The Green Stripe (visible only when selected) -->
                <Border Grid.Column="0"
                        Classes="active-stripe"
                        IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="16,0">
                    <icons:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ────────────────────────────────────
        LEFT SIDEBAR
        ──────────────────────────────────────── -->
        <Border Grid.Column="0" Classes="sidebar"  PointerPressed="TitleBar_PointerPressed">
            <DockPanel>
                <!-- Logo Area -->
                <Border DockPanel.Dock="Top" Classes="sidebar-header">
                    <Grid ColumnDefinitions="Auto, *">
                        <Image Source="/Assets/Images/Logo_main.png" Width="80" Height="50"/>
                        <StackPanel Grid.Column="1" Margin="0,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Meeting" Foreground= "{StaticResource BrushPrimary}" Classes="title-sm"/>
                            <TextBlock Text="Scribe" Foreground="White" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Top" Classes="divider-h" Margin="15,0"/>

                <!-- Navigation Menu -->
                <ListBox Background="Transparent"
                         BorderThickness="0"
                         Padding="0,8"
                         ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedMenuItem}"
                         ItemTemplate="{StaticResource MenuItemTemplate}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <!-- Selection styles -->
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource BrushSurfaceContainerHigh}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>

                <!--<Border DockPanel.Dock="Bottom" Classes="divider-h" Margin="15,0"/>-->
            </DockPanel>
        </Border>

        <!-- ────────────────────────────────────
        MAIN CONTENT
        ──────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0" Classes="top-bar" PointerPressed="TitleBar_PointerPressed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <icons:MaterialIcon Kind="{Binding SelectedMenuItem.Icon}" Width="18" Height="18"
                                            Foreground="{StaticResource BrushPrimary}"/>
                        <TextBlock Text="{Binding SelectedMenuItem.Label}" Classes="title-sm" VerticalAlignment="Center"/>
                        <Border Classes="divider-v" Height="16" />
                        <TextBlock Text="{Binding SelectedMenuItem.Description}" Classes="body-sm text-muted" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right side icons (Notifications/Help) from your mockup -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="btn-icon">
                            <icons:MaterialIcon Kind="BellOutline" Width="18" Height="18"/>
                        </Button>
                        <Button Classes="btn-icon">
                            <icons:MaterialIcon Kind="HelpCircleOutline" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Dynamic Content Area -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>

        </Grid>

    </Grid>


</Window>