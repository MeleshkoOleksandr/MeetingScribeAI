<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MeetingScribe.ViewModels"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="MeetingScribe.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel" 
        Title="MeetingScribe"
        Background="{StaticResource SurfaceBrush}">

    <Grid ColumnDefinitions="Auto, *">
        
        <!-- Sidebar -->
        <Border Grid.Column="0" 
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#2D2D2D" 
                BorderThickness="0,0,1,0">
            
            <!-- We control Sidebar width using a simple binding or hardcoded values for now -->
            <StackPanel Width="240"> <!-- Later we will make this dynamic -->
                
                <!-- Logo Area: Fixed with Border for Padding -->
                <Border Padding="20">
                    <Grid ColumnDefinitions="Auto, *">
                        <Image Source="/Assets/Images/Logo_main.png" Width="32" Height="32"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Meeting" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Scribe" Foreground="{StaticResource PrimaryBrush}" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel Margin="0,20,0,0">
                    
                    <!-- New Meeting Button (Blue highlight when not selected) -->
                    <Button Classes="Menu" 
                            Command="{Binding NavigateCommand}" 
                            CommandParameter="New"
                            Foreground="{StaticResource AccentBlueBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <PathIcon Data="{StaticResource AddIcon}"/>
                            <TextBlock Text="New Meeting"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="Menu" Command="{Binding NavigateCommand}" CommandParameter="Archive">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <PathIcon Data="{StaticResource ArchiveIcon}"/>
                            <TextBlock Text="Meeting Archive"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="Menu" Command="{Binding NavigateCommand}" CommandParameter="Team">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <PathIcon Data="{StaticResource TeamIcon}"/>
                            <TextBlock Text="Team"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="Menu" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <PathIcon Data="{StaticResource SettingsIcon}"/>
                            <TextBlock Text="Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            
            <!-- Header (Current Page Title) -->
            <Border Grid.Row="0" Height="60" Padding="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="30">
                    <TextBlock Text="{Binding CurrentPageTitle}" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Analytics" 
                               FontSize="18" 
                               Foreground="Gray" 
                               Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Dynamic Content Area -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
        </Grid>
    </Grid>
</Window>