<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MeetingScribe.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MeetingScribe.Views.TeamView" x:DataType="vm:TeamViewModel">
    <Grid ColumnDefinitions="*, 450">

        <!-- LEFT PANEL: LISTS-->
        <ScrollViewer Grid.Column="0" Padding="30">
            <StackPanel Spacing="30">

                <!-- PARTICIPANTS SECTION -->
                <StackPanel Spacing="15">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10">
                            <icons:MaterialIcon Kind="AccountMultiple" Foreground="{StaticResource BrushPrimary}"/>
                            <TextBlock Text="Participants" Classes="card-title"/>
                        </StackPanel>
                        <TextBox DockPanel.Dock="Right" Width="200" Watermark="Search..." Classes="lumina-input"/>
                    </DockPanel>

                    <ListBox ItemsSource="{Binding Participants}" SelectedItem="{Binding SelectedParticipant}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#2D2D2D" Margin="0,0,15,0">
                                            <TextBlock Text="{Binding Alias}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Position}" FontSize="12" Opacity="0.5"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Participant Control Buttons-->
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                        <Button Grid.Column="0" Content="+ ADD" Command="{Binding AddParticipantCommand}" Classes="btn-primary"/>
                        <Button Grid.Column="1" Content="DELETE" Classes="btn-secondary"/>
                        <Button Grid.Column="2" Content="CLEAR" Classes="btn-secondary"/>
                    </Grid>
                </StackPanel>

                <!-- GROUPS SECTION (similar to participants) -->
                <StackPanel Spacing="15">
                    <TextBlock Text="Groups" Classes="card-title"/>
                    <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
                        <!-- Group list -->
                    </ListBox>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT PANEL: EDITOR -->
        <Border Grid.Column="1" Background="{StaticResource BrushSurfaceContainerLow}"
                BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1,0,0,0">
            <Border Padding="30" >
                <StackPanel IsVisible="{Binding SelectedParticipant, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="25">

                    <TextBlock Text="MEMBER PROFILE" Classes="label-caps" Foreground="{StaticResource BrushSecondary}"/>

                    <!-- Photo / Avatar -->
                    <Border Width="120" Height="120" CornerRadius="15" Background="#222" HorizontalAlignment="Left">
                        <icons:MaterialIcon Kind="Account" Width="60" Height="60" Opacity="0.2"/>
                    </Border>

                    <!-- Input fields -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="FULL NAME" Classes="label-caps"/>
                        <TextBox Text="{Binding SelectedParticipant.Name}" Classes="lumina-input"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, *">
                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,10,0">
                            <TextBlock Text="ALIAS" Classes="label-caps"/>
                            <TextBox Text="{Binding SelectedParticipant.Alias}" Classes="lumina-input"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="TAG COLOR" Classes="label-caps"/>
                            <TextBox Text="{Binding SelectedParticipant.TagColor}" Classes="lumina-input"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock Text="POSITION" Classes="label-caps"/>
                        <TextBox Text="{Binding SelectedParticipant.Position}" Classes="lumina-input"/>
                    </StackPanel>

                    <Button Content="SAVE ALL CHANGES" Command="{Binding SaveAllCommand}"
                            Classes="btn-primary" HorizontalAlignment="Stretch" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>