<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MeetingScribe.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:DataType="vm:ArchiveViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MeetingScribe.Views.ArchiveView">
    <Grid ColumnDefinitions="*, 350">

        <!-- ЛЕВАЯ ЧАСТЬ: СПИСОК -->
        <Grid Grid.Column="0" RowDefinitions="Auto, Auto, *" Margin="40,20">

            <!-- Поиск и Сортировка -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,30">
                <TextBox Grid.Column="0" Text="{Binding SearchText}"
                         Watermark="Search archive..." Classes="lumina-input">
                    <TextBox.InnerLeftContent>
                        <icons:MaterialIcon Kind="Search" Width="18" Margin="10,0"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
                <Button Grid.Column="1" Classes="btn-icon" Margin="10,0,0,0">
                    <icons:MaterialIcon Kind="SortVariant"/>
                </Button>
            </Grid>

            <TextBlock Grid.Row="1" Text="Archive" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Список совещаний -->
            <ListBox Grid.Row="2" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding FilteredMeetings}"
                     SelectedItem="{Binding SelectedMeeting}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="20" CornerRadius="8" Margin="0,0,0,10" Background="#1a1d15">
                            <Grid RowDefinitions="Auto, Auto, Auto">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"/>
                                    <Border Background="#2D2D2D" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="Q3 Roadmap" FontSize="10" Opacity="0.6"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding Description}"
                                           FontSize="13" Opacity="0.5" Margin="0,5,0,10" MaxLines="1"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="20" Opacity="0.4">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <icons:MaterialIcon Kind="Calendar" Width="14"/>
                                        <TextBlock Text="{Binding StartTime, StringFormat=\{0:MMM dd yyyy\}}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <icons:MaterialIcon Kind="ClockOutline" Width="14"/>
                                        <TextBlock Text="{Binding Duration, StringFormat=\{0:hh\\:mm\}}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ПРАВАЯ ЧАСТЬ: ДЕТАЛИ -->
        <Border Grid.Column="1" Background="{StaticResource BrushSurfaceContainerLow}" Padding="20"
                BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1,0,0,0">

            <!-- Показываем детали только если что-то выбрано -->
            <Grid IsVisible="{Binding SelectedMeeting, Converter={x:Static ObjectConverters.IsNotNull}}"
                  RowDefinitions="Auto, *, Auto" >

                <StackPanel Grid.Row="0" Spacing="10">
                    <TextBlock Text="MEETING DETAILS" Classes="label-caps" Foreground="{StaticResource BrushSecondary}" Opacity="0.6"/>
                    <TextBlock Text="{Binding SelectedMeeting.Name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" Margin="0,15,0,0"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Opacity="0.4">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <icons:MaterialIcon Kind="Calendar" Width="14"/>
                            <TextBlock Text="{Binding SelectedMeeting.StartTime, StringFormat=\{0:MMM dd yyyy\}}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <icons:MaterialIcon Kind="ClockOutline" Width="14"/>
                            <TextBlock Text="{Binding SelectedMeeting.Duration, StringFormat=\{0:hh\\:mm\}}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,20,0,0">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="DESCRIPTION" Classes="label-caps" Opacity="0.6"/>
                            <TextBlock Text="{Binding SelectedMeeting.Description}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>

                        <!-- Темы (заглушка) -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="KEY TOPICS" Classes="label-caps" Opacity="0.6"/>
                            <Border Classes="chip" HorizontalAlignment="Left"><TextBlock Text="AI Feature Prioritization"/></Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Кнопки внизу -->

                <StackPanel  Spacing="10" Grid.Row="2"  >
                    <Border Grid.Row="5" Classes="divider-h" Margin="0,10" Opacity="0.6"/>
                    <Button Classes="btn-accent" Command="{Binding OpenSelectedMeetingCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:MaterialIcon Kind="OpenInApp" Width="18"/>
                            <TextBlock Text="Open Recording"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="btn-secondary" HorizontalAlignment="Stretch" Foreground="#FF5252">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:MaterialIcon Kind="DeleteOutline" Width="18"/>
                            <TextBlock Text="Delete Archive"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>