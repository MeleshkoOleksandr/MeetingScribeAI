<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MeetingScribe.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:MeetingScribe.UILogic"
             x:DataType="vm:ArchiveViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MeetingScribe.Views.ArchiveView">
    <Grid ColumnDefinitions="*, 320">

        <!-- LEFT SIDE: LIST -->
        <Grid Grid.Column="0" RowDefinitions="Auto, Auto, *" Margin="25,20,5,25">      
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                 <!-- Search -->
                <TextBox Grid.Column="0" Text="{Binding SearchText}"
                         PlaceholderText="{loc:L view_Archive_SearchPlaceholder}" Classes="lumina-input">
                    <TextBox.InnerLeftContent>
                        <icons:MaterialIcon Kind="Search" Width="18" Margin="10,0"/>
                    </TextBox.InnerLeftContent>
                </TextBox>
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="10,0">    
                <!-- Sort -->
                <Button Background="Transparent" Padding="5" Cursor="Hand" >
                <StackPanel Orientation="Horizontal" >
                    <icons:MaterialIcon Kind="Sort" Width="25" Height="25"
                                        Foreground="{StaticResource BrushPrimary}" />
                    <TextBlock Text="{Binding SelectedSortOption}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" 
                               Foreground="{StaticResource BrushPrimary}" Opacity="0.9"/>
                </StackPanel>
                <!-- (Flyout) -->
                <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding SortOptions}">
                        <!-- Customize the appearance of each item -->
                        <MenuFlyout.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding}"/>
                                <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:ArchiveViewModel)DataContext).ApplySortCommand}"/>
                                <Setter Property="CommandParameter" Value="{Binding}"/>
                            </ControlTheme>
                        </MenuFlyout.ItemContainerTheme>
                    </MenuFlyout>
                </Button.Flyout>
                </Button>
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="{loc:L view_Archive_Title}" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
            <!-- List of Meetings -->
            <ListBox Grid.Row="2" Background="Transparent" BorderThickness="0" Classes="LuminaList"
                     ItemsSource="{Binding FilteredMeetings}"
                     SelectedItem="{Binding SelectedMeeting}">
  
                <ListBox.ItemTemplate>       
                    <DataTemplate>
                        <Border Padding="20,15" Background="Transparent">
                            <Grid ColumnDefinitions="*, Auto" >
                                <!-- Text block -->
                                <StackPanel Grid.Column="0">
                                   
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="White"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                  
                                    <TextBlock Text="{Binding Description}" FontSize="14" Foreground="Gray"
                                               Margin="0,0,0,12" MaxLines="1" TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal" Spacing="20">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <icons:MaterialIcon Kind="CalendarBlank" Width="14" Foreground="Gray"/>
                                            <TextBlock Text="{Binding StartTime,  StringFormat=\{0:MMM dd yyyy\}}"
                                                       FontSize="13" Foreground="Gray"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                           <icons:MaterialIcon Kind="ClockOutline" Width="14" Foreground="Gray"/>
                                           <TextBlock FontSize="13" Foreground="Gray">
                                               <Run Text="{Binding Duration, StringFormat=\{0:mm\}}" />          
                                               <Run Text="{loc:L view_Archive_Min}" />
                                           </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <!-- More info arrow -->
                                <icons:MaterialIcon Grid.Column="1" Kind="ChevronRight" Width="20" Height="20" Foreground="Gray" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!--  RIGHT SIDE: DETAILS -->
        <Border Grid.Column="1" Background="{StaticResource BrushSurfaceContainerLow}" Padding="20"
                BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1,0,0,0">

            <!-- We display details only if something is selected -->
            <Grid IsVisible="{Binding SelectedMeeting, Converter={x:Static ObjectConverters.IsNotNull}}" RowDefinitions="Auto, *, Auto" >
                <StackPanel Grid.Row="0" Spacing="10">
                    <TextBlock Text="{loc:L view_Archive_MeetingDetails}" Classes="label-caps" Foreground="{StaticResource BrushSecondary}" Opacity="0.6"/>
                    <TextBlock Text="{Binding SelectedMeeting.Name}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <StackPanel  Orientation="Horizontal" Spacing="10" >
                        <StackPanel Orientation="Horizontal" Spacing="3" Opacity="0.4">
                            <icons:MaterialIcon Kind="Calendar" Width="14"/>
                            <TextBlock Text="{Binding SelectedMeeting.StartTime, StringFormat=\{0:MMM dd yyyy\}}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="3" Opacity="0.4">
                            <icons:MaterialIcon Kind="ClockOutline" Width="14"/>
                            <TextBlock FontSize="12">
                                <Run Text="{Binding SelectedMeeting.Duration, StringFormat=\{0:mm\}}" />       
                                <Run Text="{loc:L view_Archive_Min}" />
                            </TextBlock>
                        </StackPanel>
                        
                        <!-- Separaor -->
                        <Border Width="1" Height="10" Background="Gray" Opacity="0.2"/>
                        <!-- Transcription -->
                        <icons:MaterialIcon Kind="TextAccount" 
                                            Width="16" Height="16"
                                            Foreground="{Binding SelectedMeeting.hasTranscription, Converter={StaticResource BoolToStatusBrushConverter}}"
                                            ToolTip.Tip="{loc:L view_Archive_TranscriptionAvailable}"/>
                        <!-- Sammary -->
                        <icons:MaterialIcon Kind="AutoFix" 
                                            Width="16" Height="16"
                                            Foreground="{Binding SelectedMeeting.hasSummary, Converter={StaticResource BoolToStatusBrushConverter}}"
                                            ToolTip.Tip="{loc:L view_Archive_SummaryAvailable}"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,20,0,0">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:L view_Archive_Description}" Classes="label-caps" Opacity="0.6"/>
                            <TextBlock Text="{Binding SelectedMeeting.Description}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                        <!--   Topics -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:L view_Archive_KeyTopics}" Classes="label-caps" Opacity="0.6"/>
                            <Border Classes="chip" HorizontalAlignment="Left"><TextBlock Text="Tags mockup"/></Border>
                        </StackPanel>
                        <!--   Team -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="{loc:L view_Archive_Participants}" Classes="label-caps" Opacity="0.6"/>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                           <!-- <Border Classes="chip" CornerRadius="180" Height="30" Background="Red" HorizontalAlignment="Left"><TextBlock Text="MO"/></Border>
                                <Border Classes="chip" CornerRadius="180" Height="30" Background="BlueViolet" HorizontalAlignment="Left"><TextBlock Text="MO"/></Border>
                                <Border Classes="chip" CornerRadius="180" Height="30" Background="LightBlue" HorizontalAlignment="Left"><TextBlock Text="MO"/></Border>-->
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <!-- Bottom buttons -->
                <StackPanel  Spacing="10" Grid.Row="2">
                    <Border Classes="divider-h" Margin="0,10" Opacity="0.6"/>
                    <Button Classes="btn-accent" Command="{Binding OpenSelectedMeetingCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <icons:MaterialIcon Kind="OpenInApp" Width="18"/>
                            <TextBlock Text="{loc:L view_Archive_OpenRecording}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="btn-secondary"  Command="{Binding DeleteMeetingCommand}"  HorizontalAlignment="Stretch" Foreground="#FF5252">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <icons:MaterialIcon Kind="DeleteOutline" Width="18"/>
                            <TextBlock Text="{loc:L view_Archive_DeleteFromArchive}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>