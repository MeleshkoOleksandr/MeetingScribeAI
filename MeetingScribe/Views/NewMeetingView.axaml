<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:MeetingScribe.Logic.Meeting"
             xmlns:vm="using:MeetingScribe.ViewModels"
             x:DataType="vm:NewMeetingViewModel"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
             x:Class="MeetingScribe.Views.NewMeetingView">
    <Grid Margin="10" RowDefinitions="*, Auto">

        <Grid Grid.Row="0" RowDefinitions="Auto, *, Auto">

            <Border Grid.Row="0" Classes="card" VerticalAlignment="Stretch" Margin="0,0,0,10" MinHeight="300">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:MaterialIcon Kind="ClipboardTextOutline" Width="18" Height="18" Foreground="{StaticResource BrushPrimary}"/>
                        <TextBlock Text="Meeting Details" Classes="card-title"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="MEETING NAME" Classes="label-caps"/>
                        <TextBox Classes="lumina-input"  PlaceholderText="Enter meeting name…"  Text="{Binding MeetingName}">
                            <TextBox.InnerRightContent>
                                <Button Command="{Binding AddCurrentDateCommand}"  ToolTip.Tip="Add current date to name"
                                        Classes="btn-icon" Margin="0,0,5,0" Cursor="Hand">
                                    <icons:MaterialIcon Kind="CalendarPlus" Width="20" Foreground="{StaticResource BrushPrimary}"/>
                                </Button>
                            </TextBox.InnerRightContent>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="DESCRIPTION" Classes="label-caps"/>
                        <TextBox Classes="lumina-input" PlaceholderText="Add a description…" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="LANGUAGE" Classes="label-caps"/>
                        <ComboBox Classes="lumina-combo"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="card" VerticalAlignment="Stretch" Margin="0,0,0,10">
                <Grid RowDefinitions="Auto, *">
                    <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,16">
                        <DockPanel  LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                                <icons:MaterialIcon Kind="FormatListBulletedSquare" Width="18" Height="18" Foreground="{StaticResource BrushPrimary}"/>
                                <TextBlock Text="Meeting Topics" Classes="card-title"/>
                            </StackPanel>
                            <!--Loading an agenda from a .docx file-->
                            <Button DockPanel.Dock="Right"
                                    Classes="btn-icon-round"
                                    ToolTip.Tip="Import from .docx Agenda"
                                    Command="{Binding ImportAgendaCommand}">
                                <icons:MaterialIcon Kind="FileDocumentPlusOutline" Width="17" Height="17"/>
                            </Button>
                        </DockPanel>
                    </StackPanel>


                    <TextBox Grid.Row="1" Classes="lumina-input"
                             PlaceholderText="Enter key topics to discuss..."
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             Text="{Binding MeetingTopics}"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Classes="card">
                <StackPanel Spacing="15">

                    <!-- Header -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <icons:MaterialIcon Kind="AccountMultipleOutline" Width="18" Height="18" Foreground="{StaticResource BrushPrimary}"/>
                        <TextBlock Text="Participant List" Classes="card-title"/>

                        <Border Background="{StaticResource BrushPrimary}" CornerRadius="10" Padding="8,2" Margin="5,0">
                            <TextBlock Padding="3,3,3,0" Text="{Binding SelectedParticipants.Count, StringFormat='\{0\} added'}"
                                       FontSize="10" FontWeight="Bold" Foreground="#1e3700"/>
                        </Border>
                    </StackPanel>

                    <!-- Chips area -->
                    <WrapPanel Orientation="Horizontal">

                        <!-- Selected list -->
                        <ItemsControl ItemsSource="{Binding SelectedParticipants}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Participant">
                                    <Border Classes="participant-chip"
                                            BorderBrush="{Binding TagColor, Converter={StaticResource HexToBrushConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <!-- Mini avatar or aleas -->
                                            <Panel Width="34" Height="34">
                                                <Border CornerRadius="17" Background="#2D2D2D" ClipToBounds="True">
                                                    <Panel>
                                                        <TextBlock Text="{Binding Alias}" FontSize="10"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding PhotoFileName, Converter={StaticResource PathToBitmapConverter}}"
                                                               Stretch="UniformToFill"/>
                                                    </Panel>
                                                </Border>
                                            </Panel>

                                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>

                                            <!-- Delete button -->
                                            <Button Command="{Binding $parent[UserControl].((vm:NewMeetingViewModel)DataContext).RemoveParticipantCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="chip-delete">
                                                <icons:MaterialIcon Kind="Close" Width="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add button (+) -->
                        <Button Classes="btn-icon-round" Width="40" Height="40">
                            <icons:MaterialIcon Kind="Plus" Width="20"/>
                            <Button.Flyout>
                                <MenuFlyout ItemsSource="{Binding AvailableToJoin}">
                                    <MenuFlyout.ItemContainerTheme>
                                        <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="models:Participant">
                                            <Setter Property="Header" Value="{Binding Name}"/>
                                            <Setter Property="Command" Value="{Binding $parent[UserControl].((vm:NewMeetingViewModel)DataContext).AddParticipantCommand}"/>
                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                            <Setter Property="Icon">
                                                <Template>
                                                    <icons:MaterialIcon Kind="AccountCircle"
                                                                        Foreground="{Binding TagColor, Converter={StaticResource HexToBrushConverter}}"/>
                                                </Template>
                                            </Setter>
                                        </ControlTheme>
                                    </MenuFlyout.ItemContainerTheme>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                    </WrapPanel>

                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="2*, 1*" ColumnSpacing="10">
            <Button Grid.Column="0" Classes="btn-primary" HorizontalAlignment="Stretch" Height="50" Margin="0,10,0,0"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).StartMeetingCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="Microphone" Width="20" Height="20" Foreground="{StaticResource BrushOnPrimary}"/>
                    <TextBlock Text="Start Recording" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushOnPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="btn-accent" HorizontalAlignment="Stretch" Height="50" Margin="0,10,0,0"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LoadMeetingFromFileCommand}">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="Waveform" Width="20" Height="20" Foreground="{StaticResource ColorOnSecondary}"/>
                    <TextBlock Text="Load from file" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ColorOnSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>


    </Grid>
</UserControl>