<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
             x:Class="MeetingScribe.Views.NewMeetingView">
    <Grid Margin="10" RowDefinitions="*, Auto">

        <Grid Grid.Row="0" RowDefinitions="Auto, *, Auto">

            <Border Grid.Row="0" Classes="card" VerticalAlignment="Stretch" Margin="0,0,0,10" MinHeight="300">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <icons:MaterialIcon Kind="ClipboardTextOutline" Width="18" Height="18" Foreground="{StaticResource BrushPrimary}"/>
                        <TextBlock Text="Meeting Details" Classes="card-title"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="MEETING NAME" Classes="label-caps"/>
                        <TextBox Classes="lumina-input" Text="Weekly Sync" Watermark="Enter meeting name…"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="DESCRIPTION" Classes="label-caps"/>
                        <TextBox Classes="lumina-input" Text="Discuss project updates..." Watermark="Add a description…" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="LANGUAGE" Classes="label-caps"/>
                        <ComboBox Classes="lumina-combo" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem>Italiano</ComboBoxItem>
                            <ComboBoxItem>English</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="card" VerticalAlignment="Stretch" Margin="0,0,0,10">
                <Grid RowDefinitions="Auto, *">
                    <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="FormatListBulletedSquare" Width="18" Height="18" Foreground="{StaticResource BrushPrimary}"/>
                            <TextBlock Text="Meeting Topics" Classes="card-title"/>
                        </StackPanel>
                        <TextBlock Text="DISCUSSION POINTS" Classes="label-caps"/>
                    </StackPanel>

                    <TextBox Grid.Row="1" Classes="lumina-input"
                             Watermark="Enter key topics to discuss..."
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Classes="card" VerticalAlignment="Bottom">
                <StackPanel Spacing="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                            <icons:MaterialIcon Kind="AccountMultipleOutline" Width="18" Height="18" Foreground="{StaticResource BrushPrimary}"/>
                            <TextBlock Text="Participant List" Classes="card-title"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Classes="badge" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="3 Added"/>
                        </Border>
                    </DockPanel>
                    <WrapPanel Orientation="Horizontal" >

                        <Border Classes="chip" >
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Border Classes="avatar" Background="#3A6EA5">
                                    <TextBlock Text="AM" FontSize="10"  Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Classes="btn-icon" Width="16" Height="16"
                                        Padding="1" VerticalAlignment="Center">
                                    <icons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Classes="chip" >
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Border Classes="avatar" Background="Green">
                                    <TextBlock Text="LD" FontSize="10"  Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Classes="btn-icon" Width="16" Height="16"
                                        Padding="1" VerticalAlignment="Center">
                                    <icons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Classes="chip" Margin="3,3,3,3">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <Border Classes="avatar" Background="IndianRed">
                                    <TextBlock Text="FK" FontSize="10"  Margin="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Classes="btn-icon" Width="16" Height="16"
                                        Padding="1" VerticalAlignment="Center">
                                    <icons:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                </Button>
                            </StackPanel>
                        </Border>

                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="2*, 1*" ColumnSpacing="10">
            <Button Grid.Column="0" Classes="btn-primary" HorizontalAlignment="Stretch" Height="50" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="Microphone" Width="20" Height="20" Foreground="{StaticResource BrushOnPrimary}"/>
                    <TextBlock Text="Start Recording" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushOnPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="btn-accent" HorizontalAlignment="Stretch" Height="50" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <icons:MaterialIcon Kind="Waveform" Width="20" Height="20" Foreground="{StaticResource ColorOnSecondary}"/>
                    <TextBlock Text="Load from file" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource ColorOnSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>


    </Grid>
</UserControl>