<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:ctxt="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
             xmlns:controls="clr-namespace:MeetingScribe.Views.Controls;assembly=MeetingScribe"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:uilogic="using:MeetingScribe.UILogic"
             xmlns:vm="using:MeetingScribe.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MeetingScribe.Views.ReviewMeetingView"
             x:DataType="vm:ReviewMeetingViewModel">

    <Grid RowDefinitions="*, 60">
        <Grid ColumnDefinitions="*, 300">

            <!-- ========================================== -->
            <!--   MAIN SECTION: DYNAMIC CONTENT            -->
            <!-- ========================================== -->
            <Border Grid.Column="0" Background="{StaticResource BrushSurfaceContainerLowest}" x:Name="MainContentBorder"  >
                <Grid >
                    <!-- 1. MODE: SCRIPT (Transcription) -->
                    <Border Padding="20,20,0,0" IsVisible="{Binding IsTranscriptionView}" >
                        <ScrollViewer IsVisible="{Binding IsTranscriptionView}">
                            <ItemsControl ItemsSource="{Binding Session.FullTranscript}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="80, *" Margin="0,0,30,20">
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Classes="timestamp"/>
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <TextBlock Text="{Binding SpeakerName}" Foreground="{StaticResource BrushSecondary}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16" Opacity="0.9"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 2. MODE: SUMMARY (Markdown) -->
                    <Border Padding="20,10,10,10" IsVisible="{Binding IsSummaryView}" >
                        <md:MarkdownScrollViewer
                            Markdown="{Binding Session.GeneralSummary}"
                            SelectionEnabled="True"  >
                            <md:MarkdownScrollViewer.Styles>
                                <Style Selector="ctxt|CTextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BrushOnSurface}"/>
                                    <Setter Property="FontSize" Value="16"/>

                                </Style>
                                <Style Selector="ctxt|CTextBlock.Heading1">
                                    <Setter Property="FontSize" Value="24"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                                <Style Selector="ctxt|CTextBlock.Heading2">
                                    <Setter Property="FontSize" Value="20"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </md:MarkdownScrollViewer.Styles>
                        </md:MarkdownScrollViewer>
                    </Border>

                    <!-- 3. MODE: INFO (Metadata Editor) -->
                    <ScrollViewer IsVisible="{Binding IsInfoView}" Padding="20" >
                        <StackPanel  Spacing="25">
                            <TextBlock Text="Meeting Metadata" FontSize="22" FontWeight="Bold"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="MEETING NAME" Classes="label-caps"/>
                                <TextBox Text="{Binding Session.Name}" Classes="lumina-input"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="DESCRIPTION" Classes="label-caps"/>
                                <TextBox Text="{Binding Session.Description}"
                                         AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap" Classes="lumina-input"/>
                            </StackPanel>

                               <StackPanel Spacing="6">
                                <TextBlock Text="Meeting Topics" Classes="label-caps"/>
                                <TextBox Text="{Binding Session.MeetingTopics}"
                                         AcceptsReturn="True" MinHeight="150" TextWrapping="Wrap" Classes="lumina-input"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!--   RIGHT PANEL: FUNCTIONS                   -->
            <!-- ========================================== -->
            <Border Grid.Column="1" Background="{StaticResource BrushSurfaceContainerLow}"
                    BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="1,0,0,0">

                <Grid RowDefinitions="Auto, *, Auto, Auto">

                    <!--Top: Tabs-->
                    <StackPanel Grid.Row="0">
                        <Border Background="{StaticResource BrushSurfaceContainerHigh}" Margin="10" CornerRadius="10" Padding="10">
                            <Grid ColumnDefinitions="*, *, *">
                                <ToggleButton Grid.Column="0" Content="Script" IsChecked="{Binding IsTranscriptionView}" Classes="tab"/>
                                <ToggleButton Grid.Column="1" Content="Summary" IsChecked="{Binding IsSummaryView}" Classes="tab"/>
                                <ToggleButton Grid.Column="2" Content="Info" IsChecked="{Binding IsInfoView}" Classes="tab"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Middle: Dynamic Buttons -->
                    <ScrollViewer Grid.Row="1" Padding="20,0">

                        <StackPanel Spacing="20">
                            <!-- Script -->
                            <StackPanel Spacing="10" IsVisible="{Binding IsTranscriptionView}"    >
                                <TextBlock Text="SCRIPT ACTIONS" Classes="label-caps" Opacity="0.6"/>
                                <Button Classes="btn-secondary" Command="{Binding ImproveRecognitionCommand}"
                                        IsVisible="{Binding !IsImprovingText}" IsEnabled="{Binding !IsGlobalBusy}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <icons:MaterialIcon Kind="AutoFix" Width="18"/>
                                        <TextBlock Text="Improve Recognition"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="btn-secondary" Command="{Binding CancelCurrentActionCommand}" IsVisible="{Binding IsImprovingText}"
                                        HorizontalAlignment="Stretch" Background="#332020">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <icons:MaterialIcon Kind="CloseCircleOutline" Foreground="#ffb4ab"/>
                                        <TextBlock Text="Cancel Process" Foreground="#ffb4ab"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="btn-secondary" Command="{Binding SplitBySpeakersCommand}"
                                        IsVisible="{Binding !IsAIRef}" IsEnabled="{Binding !IsGlobalBusy}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <icons:MaterialIcon Kind="AccountConvert" Width="18"/>
                                        <TextBlock Text="Diarization and Refinement"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="btn-secondary" Command="{Binding CancelCurrentActionCommand}" IsVisible="{Binding IsAIRef}"
                                        HorizontalAlignment="Stretch" Background="#332020">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <icons:MaterialIcon Kind="CloseCircleOutline" Foreground="#ffb4ab"/>
                                        <TextBlock Text="Cancel Process" Foreground="#ffb4ab"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Summary -->
                            <StackPanel Spacing="10" IsVisible="{Binding IsSummaryView}">
                                <TextBlock Text="AI SUMMARY" Classes="label-caps" Opacity="0.6"/>
                                <Button Classes="btn-accent" Command="{Binding GenerateFinalSummaryCommand}" IsEnabled="{Binding !IsGlobalBusy}"  HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal"  Spacing="10">
                                        <icons:MaterialIcon Kind="Magic" Width="18"/>
                                        <TextBlock Text="General Summary"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="btn-accent" Command="{Binding GenerateTemplateSummaryCommand}"  HorizontalAlignment="Stretch" IsEnabled="{Binding !IsGlobalBusy}" >
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <icons:MaterialIcon Kind="Magic" Width="18"/>
                                        <TextBlock Text="Template Summary (it)"/>
                                    </StackPanel>
                                </Button>

                                <Button Classes="btn-secondary" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsGlobalBusy}" >
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <icons:MaterialIcon Kind="FileWordOutline" Width="18"/>
                                        <TextBlock Text="Export to Word"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- PROGRESS INDICATOR -->
                    <StackPanel Grid.Row="2" IsVisible="{Binding IsProcessing}" Spacing="10" Margin="0,20,0,0">

                        <TextBlock Text="{Binding CurrentTaskName}"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushPrimary}"
                                   HorizontalAlignment="Center"/>

                        <ProgressBar Height="6"
                                     Value="{Binding ProcessingProgress}"
                                     Minimum="0" Maximum="100"
                                     IsIndeterminate="{Binding IsIndeterminate}"
                                     Foreground="{StaticResource BrushPrimary}"
                                     Background="{StaticResource BrushSurfaceContainerHighest}"
                                     CornerRadius="3"/>
                    </StackPanel>

                    <!-- Bottom: Global Actions (Close/Save) -->
                    <Border Grid.Row="3" Padding="20" BorderBrush="{StaticResource BrushOutlineVariant}" BorderThickness="0,1,0,0">
                        <StackPanel Spacing="10">
                            <Button Command="{Binding SaveChangesCommand}" Classes="btn-primary" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsGlobalBusy}" >
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <icons:MaterialIcon Kind="ContentSave" IsVisible="{Binding !IsDirty}" Width="18"/>
                                    <icons:MaterialIcon Kind="ContentSaveAlert" IsVisible="{Binding IsDirty}" Foreground="#FF5252" Width="18"/>
                                    <TextBlock Text="Save Changes"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="btn-secondary"  Command="{Binding CloseReviewCommand}"  HorizontalAlignment="Stretch" Foreground="#FF5252" IsEnabled="{Binding !IsGlobalBusy}" >
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                    <icons:MaterialIcon Kind="DeleteOutline" Width="18"/>
                                    <TextBlock Text="Close Review"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM PANEL: TIMELINE -->
        <Border Grid.Row="1" Background="{StaticResource BrushSurfaceContainerLowest}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushOutlineVariant}">
            <Grid ColumnDefinitions="Auto, *, Auto" >

                <!-- Player -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                    <Button Classes="btn-icon" Width="30" Height="30">
                        <icons:MaterialIcon Kind="SkipPrevious" Width="20" Height="20" Foreground="{StaticResource BrushPrimary}"/>
                    </Button>
                    <Button Classes="btn-icon" Width="30" Height="30">
                        <icons:MaterialIcon Kind="SkipPreviousCircleOutline" Width="20" Height="20" Foreground="{StaticResource BrushPrimary}"/>
                    </Button>
                    <Button Classes="btn-primary" CornerRadius="15" Width="40" Height="40">
                        <icons:MaterialIcon Kind="Play" Width="30" Height="30"/>
                    </Button>
                    <Button Classes="btn-icon" Width="30" Height="30">
                        <icons:MaterialIcon Kind="SkipNextCircleOutline" Width="20" Height="20" Foreground="{StaticResource BrushPrimary}"/>
                    </Button>
                    <Button Classes="btn-icon" Width="30" Height="30">
                        <icons:MaterialIcon Kind="SkipNext" Width="20" Height="20" Foreground="{StaticResource BrushPrimary}"/>
                    </Button>

                </StackPanel>

                <!-- Timeline (Wave) -->
                <uilogic:LuminaAudioMeter Grid.Column="1" Height="40" VerticalAlignment="Center"/>

                <!-- Volume and Additional Information -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="5"  Margin="10,0">
                    <TextBlock Text="12:45 / 45:00" Opacity="0.5" VerticalAlignment="Center" Foreground="{StaticResource BrushSecondary}"  />

                    <icons:MaterialIcon Kind="VolumeHigh" Opacity="0.5" Foreground="{StaticResource BrushSecondary}" />
                    <ProgressBar Value="50" Opacity="0.5"
                                 Height="8" Width="80"  MinWidth="0"
                                 Foreground="{StaticResource BrushSecondary}"
                                 Background="#222"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
